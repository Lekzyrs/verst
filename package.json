{
  "name": "tilda-case",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test",
    "check:ui": "impeccable detect src",
    "check:dead": "knip",
    "check:dupes": "jscpd src",
    "check:slop": "npm run check:ui && npm run check:dead && npm run check:dupes",
    "check": "npm test && npm run build && npm run check:slop"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.2",
    "@types/three": "^0.187.0",
    "impeccable": "^4.10.0",
    "jscpd": "^5.4.3",
    "knip": "^6.46.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "three": "^0.187.0"
  }
}
